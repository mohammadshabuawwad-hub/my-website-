<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>صفحتي الشخصية</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: "Tahoma", Arial, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #eef2ff, #f8fafc);
      color: #1e293b;
      line-height: 1.8;
    }

    header {
      background: linear-gradient(135deg, #2563eb, #4f46e5);
      color: white;
      text-align: center;
      padding: 45px 20px;
      box-shadow: 0 5px 20px rgba(0,0,0,.15);
    }

    header h1 {
      font-size: 32px;
      margin-bottom: 8px;
    }

    header p {
      opacity: .9;
      font-size: 16px;
    }

    .container {
      width: 90%;
      max-width: 850px;
      margin: 35px auto;
    }

    .card {
      background: white;
      border-radius: 20px;
      padding: 25px;
      margin-bottom: 25px;
      box-shadow: 0 8px 25px rgba(15,23,42,.08);
      transition: .3s;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(15,23,42,.12);
    }

    .card h2 {
      color: #2563eb;
      margin-bottom: 15px;
      font-size: 24px;
    }

    .article-image {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 15px;
      margin-bottom: 18px;
    }

    .article-text {
      font-size: 16px;
      color: #475569;
    }

    video {
      width: 100%;
      max-height: 400px;
      border-radius: 15px;
      background: #000;
    }

    audio {
      width: 100%;
      margin-top: 10px;
    }

    .music-box {
      text-align: center;
      padding: 15px;
      background: #f1f5f9;
      border-radius: 15px;
    }

    .music-icon {
      font-size: 55px;
      margin-bottom: 10px;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #64748b;
      font-size: 14px;
    }

    @media (max-width: 600px) {
      header h1 {
        font-size: 25px;
      }

      .container {
        width: 94%;
      }

      .card {
        padding: 18px;
      }

      .article-image {
        height: 200px;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>مرحباً بكم في صفحتي</h1>
    <p>مقال • فيديو • موسيقى</p>
  </header>

  <main class="container">

    <!-- المقال -->
    <section class="card">
      <h2>📝 المقال</h2>

      <img
        class="article-image"
        src="https://images.unsplash.com/photo-1499750310107-5fef28a66643"
        alt="صورة المقال">

      <h3>عنوان المقال هنا</h3>

      <p class="article-text">
        اكتب هنا المقال الخاص بك.
        يمكنك إضافة أي نص تريده، سواء كان مقالاً شخصياً،
        قصة، موضوعاً تعليمياً أو أي محتوى آخر.
        يمكنك أيضاً إضافة أكثر من فقرة داخل هذا القسم.
      </p>
    </section>

    <!-- الفيديو -->
    <section class="card">
      <h2>🎥 الفيديو</h2>

      <video controls>
        <source src="video.mp4" type="video/mp4">
        متصفحك لا يدعم تشغيل الفيديو.
      </video>
    </section>

    <!-- الأغنية -->
    <section class="card">
      <h2>🎵 الأغنية</h2>

      <div class="music-box">
        <div class="music-icon">🎧</div>

        <h3>اسم الأغنية</h3>

        <audio controls>
          <source src="song.mp3" type="audio/mpeg">
          متصفحك لا يدعم تشغيل الصوت.
        </audio>
      </div>
    </section>

  </main>

  <footer>
    © 2026 جميع الحقوق محفوظة
  </footer>

</body>
</html>
